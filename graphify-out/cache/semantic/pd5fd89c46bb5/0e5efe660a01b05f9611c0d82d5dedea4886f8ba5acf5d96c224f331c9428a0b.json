{"nodes": [{"id": "cornice_ledger_app", "label": "Cornice Ledger (standalone HTML app)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standalone single-file, mobile-first (480px, dark theme) pay tracker for cornice makers. No browser database - everything lives in memory for the session; cornice_ledger.json is the only persistence. Pay week runs Wed-Tue. Tracks cornice entries (code, length made, units/length), day-offs, an editable rate book, and an estimated weekly pay; exports a shareable JPEG pay summary."}, {"id": "cornice_ledger_default_categories", "label": "DEFAULT_CATEGORIES (default rate table)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L593", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded default rate table grouped into the same series/sections as the original sheet (P, W, 200-900 Series). Each cornice code maps to one or more units-per-length rates (multiple rates = multiple moulds). Seeds the rate book on first run; afterwards the user's edited copy is what's used."}, {"id": "cornice_ledger_categories", "label": "categories (live rate book)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L597", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live rate categories - array of {name, codes:{CODE:[rates]}} - the editable source of truth. Session-only: always starts from DEFAULT_CATEGORIES and resets on reload because the app has no database to persist edits."}, {"id": "cornice_ledger_rates", "label": "RATES / RATE_KEYS (flat lookup cache)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L600", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flat lookup cache rebuilt from `categories` whenever it changes; enables direct rate lookup by code and prefix-match suggestions."}, {"id": "cornice_ledger_rebuildflatrates", "label": "rebuildFlatRates()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L602", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilds the flat RATES/RATE_KEYS cache from the categories array."}, {"id": "cornice_ledger_categoryofcode", "label": "categoryOfCode()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L609", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finds which rate-book category a given code belongs to."}, {"id": "cornice_ledger_normalizecode", "label": "normalizeCode()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L614", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalizes user-typed cornice codes: trims, uppercases, strips whitespace and curly quotes so code entry and lookup are lenient."}, {"id": "cornice_ledger_lookuprates", "label": "lookupRates()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L618", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the array of known rates for a normalized code, or null if the code isn't on the rate sheet."}, {"id": "cornice_ledger_state", "label": "state (in-memory database)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L653", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory state: {weekStart, days, settings}. state.days is keyed by plain ISO date and is, per the source comment, the ENTIRE database - populated only by loading a cornice_ledger.json file and read out again only when saving one."}, {"id": "cornice_ledger_days", "label": "DAYS (Wed-Tue pay week)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L652", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DAYS = ['Wed','Thu','Fri','Sat','Sun','Mon','Tue'] - the pay week runs Wed to Tue, with all 7 days selectable."}, {"id": "cornice_ledger_settings", "label": "state.settings (pay settings)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L656", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pay settings: {hourly: 28.5, hoursPerDay: 8, unitsPerDay: 36, extraRate: 3.8}; editable via the Pay Settings modal."}, {"id": "cornice_ledger_wednesdayof", "label": "wednesdayOf()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L668", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finds the Wednesday that starts the pay period (Wed-Tue week) containing a given date."}, {"id": "cornice_ledger_unsavedchanges", "label": "Unsaved-changes tracking (markDirty/markClean)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L629", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dirty tracking with a red unsaved dot in the title bar. Because nothing is saved automatically, a beforeunload handler warns that unsaved data will be lost on reload."}, {"id": "cornice_ledger_render", "label": "render()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L733", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Master re-render: redraws the week label, day chips, entry form, day ledger, week table, and pay summary."}, {"id": "cornice_ledger_renderweeklabel", "label": "renderWeekLabel()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L742", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders 'Week of X - Y (current)' for the week currently being viewed."}, {"id": "cornice_ledger_renderraychips", "label": "renderDayChips()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L750", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders the 7 day chips with active / has-entries / day-off states; tapping a chip switches the active day."}, {"id": "cornice_ledger_renderentryform", "label": "renderEntryForm()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L767", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders the day-off toggle state and disables the whole entry form when the active day is marked off (existing entries stay, new ones are blocked)."}, {"id": "cornice_ledger_renderrayledger", "label": "renderDayLedger()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L800", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders the active day's entry rows (code, qty x rate, units, delete button) and the day total line."}, {"id": "cornice_ledger_renderweektable", "label": "renderWeekTable()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L837", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders per-day entry counts and unit totals, striking through off days, plus a WEEK total row showing the working-day count."}, {"id": "cornice_ledger_rendersummary", "label": "renderSummary()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L862", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders the Estimate panel: working days, base pay, total units, unit target, remaining units, extra pay, and the estimated total pay."}, {"id": "cornice_ledger_unitsfor", "label": "unitsFor()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L798", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Units for an entry = qty x rate, rounded to 2 decimals. 'Units' = length made x units-per-length rate recorded at time of entry."}, {"id": "cornice_ledger_isdayoffdate", "label": "isDayOffDate()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L705", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A day defaults to off on Saturday/Sunday and working on every other day, unless explicitly overridden by the day record's off flag."}, {"id": "cornice_ledger_setdayoffdate", "label": "setDayOffDate()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L711", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overrides a day's off/working status, marks data dirty, and re-renders."}, {"id": "cornice_ledger_workingdayscount", "label": "workingDaysCount()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L833", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts the week's days that aren't marked off; drives both base pay and the unit target."}, {"id": "cornice_ledger_updateforcode", "label": "updateForCode()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L900", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On code entry: a single known rate auto-fills the rate input; multiple moulds show tap-to-pick A/B/C variant chips (first preselected); an unknown code shows a 'custom' hint and the user types a rate."}, {"id": "cornice_ledger_updatesuggestions", "label": "updateSuggestions()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L933", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefix-match autocomplete over known codes (max 8), each suggestion showing its rate(s); picking one fills the code and advances focus to qty."}, {"id": "cornice_ledger_addentry", "label": "addEntry()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L962", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates code/qty/rate, blocks entry on day-off days, pushes {id, code, qty, rate} into the active day, marks data dirty, clears the form, and re-renders."}, {"id": "cornice_ledger_removeentry", "label": "removeEntry()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L990", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletes an entry by id from the active day, marks data dirty, and re-renders."}, {"id": "cornice_ledger_builddbobject", "label": "buildDbObject()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1062", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serializes state to a deliberately human-readable v2 JSON: human date keys ('wednesday 12/08/2026'), entry keys 'CODE (rate)' with same code+rate quantities merged, _off flags for day-offs, plus settings and app metadata."}, {"id": "cornice_ledger_applydbobject", "label": "applyDbObject()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1084", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inverse of buildDbObject: parses the JSON back into state (settings + ISO-keyed days with entries), regenerating entry ids."}, {"id": "cornice_ledger_savedb", "label": "saveDB()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads the serialized state as cornice_ledger.json via a Blob anchor click; marks data clean."}, {"id": "cornice_ledger_loaddbfile", "label": "loadDBFile()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads a chosen cornice_ledger.json, confirms that it replaces everything currently shown (all weeks and settings), applies it, and re-renders."}, {"id": "cornice_ledger_tryautoload", "label": "tryAutoLoad()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-effort fetch of ./cornice_ledger.json on init - works when the page is served from a real web server, silently fails under plain file:// (e.g. Safari) where the Load button is used instead."}, {"id": "cornice_ledger_json", "label": "cornice_ledger.json (persistence file)", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L555", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app's only persistence layer. Nothing is saved automatically; Save downloads it and Load opens a copy back in. The user must keep the file somewhere safe (e.g. next to the HTML in Files) and load it each time the app is reopened."}, {"id": "cornice_ledger_paycalculation", "label": "Pay calculation (base + extra over unit target)", "file_type": "rationale", "source_file": "cornice_ledger.html", "source_location": "L862", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estimated pay = base pay + extra pay. Base pay = hourly x hoursPerDay x working days. Unit target = unitsPerDay x working days. Extra pay = max(0, totalUnits - target) x extraRate. Base pay and the unit target both multiply by however many days this week aren't marked Day Off."}, {"id": "cornice_ledger_buildweekreport", "label": "buildWeekReport()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draws a clean, printable, pay-dispute-ready weekly sheet: daily tallies with the cornice code/qty/rate/units behind each entry, plus the full pay calculation. Runs the same layout function twice - once with ctx=null just to measure the total height needed, then again on a properly-sized canvas - so the two passes can never drift out of sync."}, {"id": "cornice_ledger_exportweekasjpeg", "label": "exportWeekAsJPEG()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1378", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-pass canvas render at 2x scale for sharper output, exported as a downloadable JPEG named cornice_pay_summary_<weekStart>.jpg."}, {"id": "cornice_ledger_roundrectpath", "label": "roundRectPath()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canvas rounded-rectangle path helper used by the pay summary report."}, {"id": "cornice_ledger_showconfirm", "label": "showConfirm()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1406", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promise-based custom confirm dialog replacing native confirm(), which can be unreliable in sandboxed views."}, {"id": "cornice_ledger_showtextprompt", "label": "showTextPrompt()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1425", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promise-based custom text-input dialog replacing native prompt(), which can be unreliable in sandboxed views."}, {"id": "cornice_ledger_rendercategorylist", "label": "renderCategoryList()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1467", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders the Rate Book: collapsible category blocks with codes and rates, search filtering (auto-expands sections while searching, hides empty ones), rename/delete actions per section, and add-cornice rows."}, {"id": "cornice_ledger_renamecategory", "label": "renameCategory()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1548", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renames a rate-book section via a text prompt, guarding against duplicate section names."}, {"id": "cornice_ledger_deletecategory", "label": "deleteCategory()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1563", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletes a section after confirmation; its cornice codes are moved to an 'Uncategorized' section rather than lost."}, {"id": "cornice_ledger_opencodemodal", "label": "openCodeModal()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1607", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens the add/edit cornice modal, prefilling the code, its category, and one rate row per mould (a code can have multiple moulds/rates)."}, {"id": "cornice_ledger_init", "label": "init()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L1689", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Init IIFE: loads the default rate table, attempts auto-load of cornice_ledger.json, sets the active day to today's weekday, and performs the first render."}, {"id": "cornice_ledger_toast", "label": "toast()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L660", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transient toast notification at the bottom of the screen; auto-hides after 1.6s."}, {"id": "cornice_ledger_loadratetable", "label": "loadRateTable()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L636", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session-only rate table load: always starts from the hardcoded DEFAULT_CATEGORIES. Edits made in the Rate Book work for this session but reset on reload because the app now has no database to save them to."}, {"id": "cornice_ledger_saveratetable", "label": "saveRateTable()", "file_type": "code", "source_file": "cornice_ledger.html", "source_location": "L643", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilds the flat rate cache after Rate Book edits; there is no persistent storage - the rate book is session-only."}, {"id": "cornice_ledger_fileonly_persistence", "label": "File-only persistence (no browser DB)", "file_type": "rationale", "source_file": "cornice_ledger.html", "source_location": "L624", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate design: no browser database at all (no localStorage/IndexedDB) - everything lives in memory for the session and cornice_ledger.json is the only place data lives. Trade-off: nothing survives a reload unless the user has saved the file."}], "edges": [{"source": "cornice_ledger_app", "target": "cornice_ledger_init", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "cornice_ledger.html", "source_location": "L1689", "weight": 1.0}, {"source": "cornice_ledger_init", "target": "cornice_ledger_loadratetable", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_f